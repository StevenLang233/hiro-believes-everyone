<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ManosabaTrial12Fix</AssemblyName>
    <RootNamespace>ManosabaTrial12Fix</RootNamespace>
    <Company>StevenLang</Company>
    <Product>希罗宝宝拯救器 | 让希罗宝宝相信大家</Product>
    <Description>此mod修复某些情况下（鬼知道啥情况）希罗宝宝无法相信大家（不能点罢了）的bug。使用 GPT-6 Luna 开发的 vibe coding 项目。</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameRoot)' == '' and '$(MANOSABA_GAME_DIR)' != ''">
    <GameRoot>$(MANOSABA_GAME_DIR)</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(GameRoot)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GameRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GameRoot)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Elringus.Naninovel.Runtime" HintPath="$(GameRoot)\BepInEx\interop\Elringus.Naninovel.Runtime.dll" Private="false" />
    <Reference Include="Naninovel.Common" HintPath="$(GameRoot)\BepInEx\interop\Naninovel.Common.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameRoot)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
